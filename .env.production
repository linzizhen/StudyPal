# StudyPal 环境变量配置（生产环境示例）
# 复制此文件为 .env 并填写实际值

# ==================== Flask 配置 ====================
FLASK_ENV=production
FLASK_DEBUG=False

# Token 签名密钥（必填）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# 多 worker 部署必须显式设置，否则各 worker 需靠密钥文件协商同一把密钥
SECRET_KEY=

PORT=5000

# ==================== AI 配置 ====================
# 默认模型配置 Key（对应 config.py 中的 MODELS_CONFIG）
# 可选值见 .env.example
DEFAULT_MODEL_KEY=groq_llama

# AI API 密钥（使用云端模型时必填）
AI_API_KEY=

# AI 请求超时时间（秒）
AI_TIMEOUT=60

# Ollama 服务地址（仅本地模型使用）
OLLAMA_BASE_URL=http://localhost:11434

# ==================== CORS 配置 ====================
# 生产环境请填具体域名，不要用 *
CORS_ORIGINS=https://studypal.example.com
